seq[int] nums = [10, 20, 30, 40, 50]

output(nums.first())
output(nums.last())
output(nums.len())
output(nums.cap())
output(nums.is_empty())
output(nums.contains(30))
output(nums.contains(99))
output(nums.index_of(40))
output(nums.sum())
output(nums.min())
output(nums.max())

:nums.reverse()
output(nums.first())
output(nums.last())
output(nums.len())

:nums.clear()
output(nums.len())
output(nums.is_empty())

seq[int] a = [5, 3, 8, 1]
output(a.sum())
output(a.min())
output(a.max())
output(a.contains(8))
output(a.first())
output(a.last())
